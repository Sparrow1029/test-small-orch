#!/bin/sh
COMMAND='uvicorn --proxy-headers --workers 4 --host 0.0.0.0 --port 8080 --reload --reload-dir small_orch/'
echo "Starting server in ${PWD}"
echo "Command: ${COMMAND}"
echo "PATH: ${PATH}"
echo $(which unicorn)

PYTHONPATH=.
python main.py db upgrade heads
/usr/src/app/.venv/bin/uvicorn --proxy-headers --workers 4 --host 0.0.0.0 --port 8080 main:app --reload --reload-dir small_orch/
